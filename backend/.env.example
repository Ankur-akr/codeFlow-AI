# ============================================
# CodeFlow AI - Backend Environment Variables
# ============================================

# Server Configuration
NODE_ENV=development
PORT=5000
FRONTEND_URL=https://acodeflow.netlify.app/

# MongoDB Configuration
MONGODB_URI=URI

# GitHub OAuth Configuration
GITHUB_CLIENT_ID=ID
GITHUB_CLIENT_SECRET=KEY
GITHUB_CALLBACK_URL=https://acodeflow.netlify.app//api/auth/github/callback

# Session Configuration
SESSION_SECRET=your_random_session_secret_here_change_in_production

# IBM Bob API Configuration
BOB_API_KEY=KEY
BOB_API_ENDPOINT=https://bob-api.ibm.com
BOB_MODEL=bob-default

# File Storage Configuration
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=104857600

# JWT Configuration
JWT_SECRET=your_random_jwt_secret_here_change_in_production
JWT_EXPIRE=7d

# Rate Limiting Configuration
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX_REQUESTS=100

# Logging Configuration
LOG_LEVEL=debug
